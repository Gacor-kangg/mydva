{
    // Simpan sebagai .vscode/launch.json (ganti file lama), lalu jalankan dengan F5.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "mydva (Chrome + env.json)",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "deviceId": "chrome",
            "toolArgs": [
                "--dart-define-from-file=env.json",
                "--web-port=8080"
            ]
        },
        {
            "name": "mydva (Chrome + env.json, release)",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "deviceId": "chrome",
            "flutterMode": "release",
            "toolArgs": [
                "--dart-define-from-file=env.json",
                "--web-port=8080"
            ]
        }
    ]
}
